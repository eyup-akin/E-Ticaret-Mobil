# Backend'in TAM adresi (şema + host, gerekiyorsa port).
#
# ⚠️ BUILD ANINDA pakete gömülüyor. APK aldıktan sonra değiştirmek
# yeniden build demek — adres kesinleşmeden APK alma.
#
# İki geçerli biçim:
#   EXPO_PUBLIC_API_TABAN=https://ornek.ts.net       (tünel/alan adı)
#   EXPO_PUBLIC_API_TABAN=http://192.168.1.42:5289   (yerel ağ)
#
# ⚠️ Android 9+ düz HTTP'yi varsayılan olarak engelliyor. http:// yalnızca
# geliştirme sırasında (Expo Go) sorunsuz; APK için https şart.
EXPO_PUBLIC_API_TABAN=https://ornek.ts.net
